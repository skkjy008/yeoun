+    double averagePerfumerRating(@Param("perfumerId") Long perfumerId);
+
+    long countByPerfumerIdAndStatus(Long perfumerId, CommissionStatus status);
+}
diff --git a/backend/src/main/java/com/yeoun/commission/service/CommissionService.java b/backend/src/main/java/com/yeoun/commission/service/CommissionService.java
