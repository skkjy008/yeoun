+/* 마이페이지 — Figma '마이페이지' 화면 기준 */
+
+.layout {
+  display: flex;
+  gap: 48px;
+  align-items: flex-start;
+  padding-bottom: 96px;
+}
+.nav {
+  flex: 0 0 208px;
+  display: flex;
+  flex-direction: column;
+  gap: 24px;
+  position: sticky;
+  top: 24px;
+}
+.greeting {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+}
+.greeting strong {
+  font-family: var(--font-serif);
+  font-size: 25px;
+  font-weight: 400;
+}
+.greeting span {
+  font-size: 12px;
+  color: var(--color-muted);
+  line-height: 1.7;
+}
+.links {
+  display: flex;
+  flex-direction: column;
+  border-top: 1px solid var(--color-ink);
+}
+.link {
+  padding: 16px 14px;
+  border-bottom: 1px solid var(--color-line);
+  font-size: 13px;
+  transition: background-color 0.2s ease;
+}
+.link:hover { background: var(--color-bg-soft); }
+.linkActive {
+  background: var(--color-sand);
+  color: var(--color-brown);
+  font-weight: 500;
+}
+.logout {
+  align-self: flex-start;
+  font-size: 12px;
+  color: var(--color-muted);
+}
+.logout:hover { color: var(--color-brown); }
+
+.content {
+  flex: 1;
+  min-width: 0;
+  display: flex;
+  flex-direction: column;
+  gap: 40px;
+}
+
+/* 멤버십 요약 */
+.membership {
+  background: var(--color-brown);
+  color: var(--color-paper);
+  padding: 32px;
+  display: grid;
+  grid-template-columns: 1fr auto auto;
+  gap: 48px;
+  align-items: flex-end;
+}
+.membership .eyebrow { color: var(--color-sand); }
+.membershipTitle {
+  font-family: var(--font-serif);
+  font-size: 29px;
+  line-height: 1.5;
+  margin-top: 10px;
+}
+.membershipStat {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  font-size: 12px;
+  color: var(--color-sand);
+}
+.membershipStat strong {
+  font-family: var(--font-serif);
+  font-size: 32px;
+  font-weight: 400;
+  color: var(--color-paper);
+  line-height: 1.2;
+}
+.membershipStat a:hover strong { text-decoration: underline; text-underline-offset: 6px; }
+
+/* 섹션 공통 */
+.block {
+  display: flex;
+  flex-direction: column;
+  gap: 20px;
+}
+.blockHead {
+  display: flex;
+  justify-content: space-between;
+  align-items: flex-end;
+  gap: 16px;
+  flex-wrap: wrap;
+}
+.blockHead h2 {
+  font-family: var(--font-serif);
+  font-size: 25px;
+}
+.blockHead span,
+.blockHead a {
+  font-size: 12px;
+  color: var(--color-muted);
+}
+.blockHead a:hover { color: var(--color-brown); }
+
+/* 등급 */
+.tiers {
+  display: grid;
+  grid-template-columns: repeat(5, 1fr);
+  gap: 10px;
+}
+.tier {
+  border: 1px solid var(--color-line);
+  background: var(--color-bg-soft);
+  padding: 16px;
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+  font-size: 12px;
+  color: var(--color-muted);
+}
+.tier strong {
+  font-family: var(--font-serif);
+  font-weight: 400;
+  font-size: 18px;
+  color: var(--color-ink);
+}
+.tierCurrent {
+  background: var(--color-sand);
+  border-color: var(--color-brown);
+}
+.tierCurrent strong { color: var(--color-brown); }
+.progress {
+  height: 5px;
+  background: var(--color-line);
+  position: relative;
+}
+.progress span {
+  position: absolute;
+  inset: 0 auto 0 0;
+  background: var(--color-brown);
+}
+.progressNote {
+  font-size: 12px;
+  color: var(--color-muted);
+}
+
+/* 주문 상태 */
+.statusBox {
+  background: var(--color-bg-soft);
+  padding: 24px;
+  display: grid;
+  grid-template-columns: repeat(4, 1fr);
+}
+.status {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 6px;
+  font-size: 12px;
+  color: var(--color-muted);
+  position: relative;
+}
+.status + .status::before {
+  content: '→';
+  position: absolute;
+  left: 0;
+  top: 50%;
+  transform: translate(-50%, -50%);
+  color: var(--color-line);
+}
+.status strong {
+  font-family: var(--font-serif);
+  font-size: 28px;
+  font-weight: 400;
+  color: var(--color-ink);
+  line-height: 1.2;
+}
+.statusActive strong { color: var(--color-brown); }
+
+/* 주문 카드 */
+.order {
+  display: flex;
+  flex-direction: column;
+}
+.orderHead {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  gap: 12px;
+  padding-bottom: 14px;
+  border-bottom: 1px solid var(--color-ink);
+  font-size: 13px;
+  flex-wrap: wrap;
+}
+.orderHead :global(.latin) { color: var(--color-muted); margin-left: 10px; font-size: 12px; }
+.orderStatus { color: var(--color-brown); font-weight: 500; }
+.orderStatusCancelled { color: var(--color-muted); }
+.orderItem {
+  display: grid;
+  grid-template-columns: 64px 1fr auto;
+  gap: 16px;
+  align-items: center;
+  padding: 14px 0;
+  border-bottom: 1px solid var(--color-line);
+  font-size: 13px;
+}
+.orderItem img {
+  width: 64px;
+  height: 64px;
+  object-fit: cover;
+  background: var(--color-sand);
+}
+.orderItem p:last-child { font-size: 11px; color: var(--color-muted); margin-top: 2px; }
+.orderFoot {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  gap: 12px;
+  padding-top: 14px;
+  font-size: 13px;
+}
+.orderTotal {
+  font-size: 19px;
+  color: var(--color-brown);
+  font-family: var(--font-latin);
+  font-weight: 500;
+}
+.orderLinks { display: flex; gap: 16px; font-size: 12px; color: var(--color-muted); }
+.orderLinks a:hover,
+.orderLinks button:hover { color: var(--color-brown); }
+
+/* 필터 탭 */
+.tabs {
+  display: flex;
+  gap: 8px;
+  flex-wrap: wrap;
+}
+.tab {
+  height: 36px;
+  padding: 0 16px;
+  border: 1px solid var(--color-line);
+  font-size: 12px;
+  background: var(--color-paper);
+}
+.tab[aria-pressed='true'] {
+  background: var(--color-brown);
+  border-color: var(--color-brown);
+  color: var(--color-paper);
+}
+
+/* 기본 정보 */
+.infoBox {
+  border: 1px solid var(--color-line);
+  padding: 28px;
+  display: flex;
+  flex-direction: column;
+  gap: 20px;
+}
+.infoHead {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  gap: 12px;
+}
+.infoHead h2 {
+  font-family: var(--font-serif);
+  font-size: 25px;
+}
+.infoHead :global(.btn) {
+  width: 150px;
+  height: 42px;
+  font-size: 13px;
+}
+.infoGrid {
+  display: grid;
+  grid-template-columns: repeat(3, 1fr);
+  gap: 20px;
+  margin: 0;
+}
+.infoGrid dt {
+  font-size: 11px;
+  color: var(--color-muted);
+  margin-bottom: 6px;
+}
+.infoGrid dd {
+  margin: 0;
+  font-size: 14px;
+  word-break: break-all;
+}
+
+/* 리스트 공통 */
+.empty {
+  padding: 48px 24px;
+  text-align: center;
+  color: var(--color-muted);
+  background: var(--color-bg-soft);
+  font-size: 13px;
+  line-height: 1.9;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 14px;
+}
+.couponList {
+  display: grid;
+  grid-template-columns: repeat(2, 1fr);
+  gap: 16px;
+}
+.coupon {
+  border: 1px solid var(--color-line);
+  background: var(--color-paper);
+  padding: 24px;
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+  position: relative;
+}
+.coupon strong {
+  font-family: var(--font-latin);
+  font-size: 28px;
+  font-weight: 500;
+  color: var(--color-brown);
+}
+.coupon p { font-size: 13px; }
+.coupon span { font-size: 11px; color: var(--color-muted); }
+.couponUsed { opacity: 0.5; }
+.pointBox {
+  background: var(--color-bg-soft);
+  padding: 24px;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  gap: 16px;
+  font-size: 13px;
+}
+.pointBox strong {
+  font-family: var(--font-serif);
+  font-size: 28px;
+  font-weight: 400;
+  color: var(--color-brown);
+}
+.reviewItem {
+  display: grid;
+  grid-template-columns: 1fr auto;
+  gap: 8px 16px;
+  padding: 20px 0;
+  border-bottom: 1px solid var(--color-line);
+  font-size: 13px;
+}
+.reviewItem a { font-weight: 500; }
+.reviewItem p { grid-column: 1 / -1; line-height: 1.8; color: var(--color-poem); }
+.stars { color: var(--color-brown); letter-spacing: 2px; }
+.form {
+  display: flex;
+  flex-direction: column;
+  gap: 18px;
+  max-width: 640px;
+}
+.form .pair {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: 16px;
+}
+.formField {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+  font-size: 13px;
+}
+.formActions {
+  display: flex;
+  gap: 10px;
+}
+.grid {
+  display: grid;
+  grid-template-columns: repeat(4, 1fr);
+  gap: 24px 16px;
+}
+.commissionRow {
+  display: grid;
+  grid-template-columns: 1fr auto;
+  gap: 6px 16px;
+  padding: 18px 0;
+  border-bottom: 1px solid var(--color-line);
+  font-size: 13px;
+}
+.commissionRow a { font-family: var(--font-serif); font-size: 18px; }
+.commissionRow span { font-size: 12px; color: var(--color-muted); }
+
+@media (max-width: 1100px) {
+  .layout { flex-direction: column; gap: 32px; align-items: stretch; }
+  .nav { position: static; flex: none; width: 100%; }
+  .links { flex-direction: row; overflow-x: auto; border-top: none; border-bottom: 1px solid var(--color-ink); }
+  .link { white-space: nowrap; border-bottom: none; }
+  .grid { grid-template-columns: repeat(2, 1fr); }
+}
+@media (max-width: 720px) {
+  .membership { grid-template-columns: 1fr 1fr; gap: 20px; padding: 24px; }
+  .membership > div:first-child { grid-column: 1 / -1; }
+  .membershipTitle { font-size: 22px; }
+  .tiers { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 6px; }
+  .tier { padding: 10px 6px; font-size: 10px; }
+  .tier strong { font-size: 14px; }
+  .statusBox { grid-template-columns: repeat(2, 1fr); row-gap: 20px; padding: 20px; }
+  .status:nth-child(3)::before { display: none; }
+  .infoGrid,
+  .couponList,
+  .form .pair { grid-template-columns: 1fr; }
+  .infoHead :global(.btn) { width: auto; }
+}
