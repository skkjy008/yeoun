+
+create table payment (
+    id              bigint       not null auto_increment,
+    member_id       bigint       not null,
+    target_type     varchar(20)  not null,
+    target_id       bigint       not null,
+    target_ref      bigint,
+    order_key       varchar(64)  not null,
+    order_name      varchar(100) not null,
+    provider        varchar(20)  not null,
+    amount          integer      not null,
+    status          varchar(20)  not null,
+    payment_key     varchar(200),
+    method_label    varchar(40),
+    receipt_url     varchar(500),
+    approved_at     datetime(6),
+    canceled_amount integer      default 0 not null,
+    canceled_at     datetime(6),
+    failure_code    varchar(60),
+    failure_message varchar(300),
+    created_at      datetime(6)  not null,
+    updated_at      datetime(6)  not null,
+    primary key (id),
+    constraint uk_payment_order_key unique (order_key),
+    constraint uk_payment_payment_key unique (payment_key),
+    constraint fk_payment_member foreign key (member_id) references member (id)
+);
+create index idx_payment_target on payment (target_type, target_id);
+
+create table settlement (
+    id            bigint      not null auto_increment,
+    commission_id bigint      not null,
+    perfumer_id   bigint      not null,
+    reason        varchar(20) not null,
+    gross_amount  integer     not null,
+    fee_amount    integer     not null,
+    net_amount    integer     not null,
+    status        varchar(20) not null,
+    paid_at       datetime(6),
+    created_at    datetime(6) not null,
+    updated_at    datetime(6) not null,
+    primary key (id),
+    constraint uk_settlement_commission unique (commission_id),
+    constraint fk_settlement_commission foreign key (commission_id) references commission (id),
+    constraint fk_settlement_perfumer foreign key (perfumer_id) references member (id)
+);
+create index idx_settlement_perfumer on settlement (perfumer_id, status);
+
+create table theme (
+    id             bigint        not null auto_increment,
+    slug           varchar(60)   not null,
+    eyebrow        varchar(60),
+    title          varchar(120)  not null,
+    subtitle       varchar(200),
+    story          varchar(2000),
+    hero_image_url varchar(300)  not null,
+    starts_on      date,
+    ends_on        date,
+    sort_order     integer       not null,
+    published      boolean       not null,
+    created_at     datetime(6)   not null,
+    updated_at     datetime(6)   not null,
+    primary key (id),
+    constraint uk_theme_slug unique (slug)
+);
+
+create table theme_product (
+    id         bigint       not null auto_increment,
+    theme_id   bigint       not null,
+    product_id bigint       not null,
+    sort_order integer      not null,
+    note       varchar(200),
+    primary key (id),
+    constraint fk_theme_product_theme foreign key (theme_id) references theme (id),
+    constraint fk_theme_product_product foreign key (product_id) references product (id)
+);
diff --git a/backend/src/main/resources/db/migration/mysql/V2_1__normalize_legacy_columns.sql b/backend/src/main/resources/db/migration/mysql/V2_1__normalize_legacy_columns.sql
new file mode 100644
index 0000000..c08d988
--- /dev/null
+++ b/backend/src/main/resources/db/migration/mysql/V2_1__normalize_legacy_columns.sql
@@ -0,0 +1,17 @@
+-- MySQL 전용: 2단계까지 Hibernate(ddl-auto=update)가 만든 기존 DB 정리
+--  · enum 컬럼 → varchar (새 상태 값 추가 시 오류 방지)
+--  · 결제 승인 번호 길이 확장 (토스페이먼츠 paymentKey 저장)
+-- 새로 만든 DB(V1)에서는 이미 같은 정의라 아무 변화가 없습니다.
+
+alter table member modify role varchar(20) not null;
+alter table member modify grade varchar(20) not null;
+alter table perfumer_application modify status varchar(20) not null;
+alter table post modify type varchar(20) not null;
+alter table notification modify type varchar(40) not null;
+alter table orders modify status varchar(20) not null;
+alter table orders modify payment_method varchar(20) not null;
+alter table orders modify payment_approval_no varchar(200);
+alter table commission modify status varchar(20) not null;
+alter table commission modify payment_method varchar(20);
+alter table commission modify payment_approval_no varchar(200);
+alter table commission_proposal modify status varchar(20) not null;
